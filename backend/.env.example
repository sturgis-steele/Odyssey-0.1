APP_NAME=Odyssey
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL=odyssey-local
DATABASE_PATH=./data/odyssey.db
MAX_TOOL_ITERATIONS=3
MAX_OUTPUT_TOKENS=512
CONTEXT_TOKENS=4096
HISTORY_TURNS=8
MODEL_TIMEOUT_SECONDS=120
TEMPERATURE=0.1
ENABLE_THINKING=false
# SYSTEM_PROMPT may override the built-in instructions.
